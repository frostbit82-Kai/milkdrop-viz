# Virtualenv and bytecode
.venv/
__pycache__/
*.pyc

# Assets are not shipped and not ours to redistribute — point the app at them
# with the texture/preset directory settings instead.
textures/
projectm-presets/
# ...except our own one file. The welcome preset samples it, so it has to
# ship; the rule above is about other people's texture packs.
!assets/textures/
!assets/textures/bomsai.png

# Local state
config.json
ratings.json
keymaps.json
*.log
kai_workflows.db

# Vendored tooling that belongs to its own project
ponytail-main/

# Fetched by installer/build_windows.ps1 on first build; 110 MB, so unlike the
# libprojectM binaries beside it this one is not worth carrying in the history.
installer/vendor/windows/ffmpeg.exe

# Installer output (the vendored libprojectM under installer/vendor IS tracked)
installer/build/
installer/dist/

# Store media: regenerated from the app, large, and uploaded to the storefront
# by hand. store/listing.md IS tracked -- it is the copy, not the media.
store/demo.mp4
store/screenshots/

# Test material: the GIFs for the burn-in work. assets/ is copied wholesale
# into the frozen bundle, so nothing that is not shipped may live there.
testdata/
