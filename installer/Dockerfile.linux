# Build environment for the Linux package.
#
# The point of it is glibc. The oldest glibc anything in the bundle was linked
# against is the oldest system the package will start on, and building on the
# developer's own distro silently pins the release to that distro: a package
# built on Ubuntu 26.04 needs glibc 2.43 and starts nowhere else.
#
# AlmaLinux 9 is glibc 2.34 -- Ubuntu 22.04+, Mint 21+, Debian 12+, RHEL 9+,
# Fedora 35+, current Arch and SteamOS -- and is supported to 2032.
#
# **2.34 is PySide6's floor, not a choice.** Its wheels are tagged
# `manylinux_2_34` from 6.10 onward, so no base below that can install the Qt
# this app ships: on a glibc 2.28 image pip offers 6.9.3 as its newest.
# Reaching Ubuntu 20.04 / Debian 10 therefore costs two Qt minor versions, and
# is a product decision rather than a packaging one.
#
# Debian was the obvious base and is the wrong one either way: bookworm floors
# at 2.36, which does not even cover the Mint 21 this was tested on, and
# bullseye (2.31) left security support on 2026-08-31 -- its apt repository no
# longer verifies and its libraries will never be patched again.
#
# The manylinux images are the same AlmaLinux and cannot be used: their CPythons
# are built static, and PyInstaller needs a shared libpython. The distro's own
# python3.14 has one, and is a version newer than Debian's anyway.
ARG BASE=almalinux:9
FROM ${BASE}

# The Qt runtime libraries are here for the *build*, not to be shipped.
# PyInstaller imports PySide6.QtCore to find out which Qt libraries and plugins
# to collect; without libglib and libdbus that import fails, and it carries on
# with a warning and quietly bundles far less than it should. The tell is the
# tarball coming out ~26 MB smaller than one built on a normal desktop.
# glm is not in the list because projectM vendors its own.
RUN dnf -y install epel-release \
    && dnf -y install \
        python3.14 python3.14-devel \
        gcc-toolset-14 make cmake pkgconf-pkg-config ca-certificates \
        mesa-libGL-devel mesa-libEGL-devel portaudio \
        glib2 dbus-libs fontconfig freetype libxkbcommon-x11 \
        libX11 libXext libXrender libXrandr libXfixes libxcb \
        xcb-util-cursor xcb-util-image xcb-util-keysyms \
        xcb-util-renderutil xcb-util-wm \
    && dnf clean all

# The build script says `python`; the RPM only installs versioned names.
RUN ln -s /usr/bin/python3.14 /usr/local/bin/python

# libprojectM is built with gcc 14, not the distro's gcc 11, and the difference
# is measurable: the same preset ran at ~640 fps against a gcc 11 build and
# ~890 against this one, uncapped at 1280x720 on a Radeon Pitcairn. gcc-toolset
# exists for exactly this -- it links the newer libstdc++ symbols statically,
# so the library still runs against AlmaLinux 9's own runtime and the glibc
# floor does not move. Check the floor after any toolset change.
ENV PATH="/opt/rh/gcc-toolset-14/root/usr/bin:${PATH}"
