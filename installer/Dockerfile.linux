# Build environment for the Linux package.
#
# The point of it is glibc. The oldest glibc anything in the bundle was linked
# against is the oldest system the package will start on, and building on the
# developer's own distro silently pins the release to that distro: a package
# built on Ubuntu 26.04 needs glibc 2.43 and starts nowhere else.
#
# Debian 12 (bookworm) is glibc 2.36 — Debian 12+, Ubuntu 24.04+, Fedora 37+,
# current Arch and SteamOS. Going lower means building Python as well, because
# there is no python:3.14 image older than bookworm; BASE is an ARG so that
# stays a one-line change rather than a rewrite.
ARG BASE=python:3.14-slim-bookworm
FROM ${BASE}

# The Qt runtime libraries are here for the *build*, not to be shipped.
# PyInstaller imports PyQt6.QtCore to find out which Qt libraries and plugins to
# collect; without libglib and libdbus that import fails, and it carries on with
# a warning and quietly bundles far less than it should. The tell is the tarball
# coming out ~26 MB smaller than one built on a normal desktop.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake pkg-config ca-certificates \
        libgl1-mesa-dev libglm-dev libportaudio2 \
        libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 \
        libegl1 libopengl0 libxkbcommon-x11-0 \
        libx11-6 libxext6 libxrender1 libxcb1 libxcb-cursor0 libxcb-icccm4 \
        libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
        libxcb-shape0 libxcb-sync1 libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 \
    && rm -rf /var/lib/apt/lists/*
