MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=10.000000
fGammaAdj=1.400
fDecay=0.960
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=2
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.450
fWaveScale=1.100
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=1.300
fWarpAnimSpeed=0.600
fWarpScale=1.200
fZoomExponent=1.000
fShader=0.000
zoom=1.00400
rot=0.00200
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.02000
sx=1.000
sy=1.000
wave_r=0.900
wave_g=0.720
wave_b=0.280
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_1=wave_r = 0.90 + 0.10 * bass_att;
per_frame_2=wave_g = 0.66 + 0.14 * mid_att;
per_frame_3=wave_b = 0.24 + 0.16 * treb_att;
per_frame_4=zoom = 1.004 + 0.006 * bass_att;
per_frame_5=rot = 0.002 * sin(time * 0.20);
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz * 0.985;
warp_4=`}
comp_1=`sampler sampler_fc_bomsai;
comp_2=`shader_body
comp_3=`{
comp_4=`    ret = tex2D(sampler_main, uv).xyz;
comp_5=`
comp_6=`    // The logo, centred and square whatever the window shape is.
comp_7=`    float2 p = uv - 0.5;
comp_8=`    p.x *= texsize.x / texsize.y;
comp_9=`    float s = 0.42 + 0.03 * bass_att;
comp_10=`    float2 lu = p / s + 0.5;
comp_11=`
comp_12=`    float4 logo = tex2D(sampler_fc_bomsai, lu);
comp_13=`    float inside = (lu.x > 0) * (lu.x < 1) * (lu.y > 0) * (lu.y < 1);
comp_14=`    float a = logo.a * inside;
comp_15=`
comp_16=`    // Its own dark medallion, so the logo reads over whatever the
comp_17=`    // waveform is doing behind it.
comp_18=`    float disc = saturate(1 - length(p) / (s * 1.25));
comp_19=`    disc = disc * disc;
comp_20=`    ret *= lerp(1.0, 0.22, disc);
comp_21=`    ret += float3(0.13, 0.10, 0.035) * disc;
comp_22=`
comp_23=`    ret = lerp(ret, logo.xyz, a);
comp_24=`}
